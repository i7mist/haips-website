---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { organizers } from '../data/organizers2026.js';

type Speaker = {
    name: string;
    affiliation: string;
    website?: string;
    profilePic?: string;
};

const speakers: Speaker[] = [
    {
        name: 'Helen Nissenbaum',
        affiliation: 'Cornell Tech',
        website: 'https://nissenbaum.tech.cornell.edu/',
        profilePic: '/speaker-helen-nissenbaum.jpg',
    },
    {
        name: 'Ruoxi Jia',
        affiliation: 'Virginia Tech',
        website: 'https://ruoxijia.net',
        profilePic: '/speaker-ruoxi-jia.jpg',
    },
    {
        name: 'Maarten Sap',
        affiliation: 'Carnegie Mellon University',
        website: 'https://maartensap.com/',
        profilePic: '/speaker-maarten-sap.jpg',
    },
    {
        name: 'Nina Taft',
        affiliation: 'Google',
        website: 'https://research.google/people/nina-taft/',
        profilePic: '/speaker-nina-taft.png',
    },
    {
        name: 'Florian Tramèr',
        affiliation: 'ETH Zurich',
        website: 'https://floriantramer.com/',
        profilePic: '/speaker-florian-tramer.png',
    },
];

type ScheduleItem = {
    start: string;
    end: string;
    kind: 'talk' | 'panel' | 'spotlight' | 'break' | 'misc';
    session: string;
    who?: string;
    talk?: string;
    abstract?: string;
    paper?: string;
    authors?: string;
    note?: string;
};

const schedule: ScheduleItem[] = [
    { start: '9:00', end: '9:10', kind: 'misc', session: 'Opening remarks' },
    {
        start: '9:10',
        end: '9:40',
        kind: 'talk',
        session: 'Invited talk',
        who: 'Florian Tramèr (ETH Zurich)',
        talk: 'LLMs as OSINT operatives',
        abstract: 'Collecting, analyzing and using public data to answer intelligence questions. That sounds like exactly the type of thing LLMs are good at, no? This is also the definition of OSINT ("open source intelligence"), and I argue that LLMs are going to democratize these practices by giving everyone access to a cheap, automated and massively scalable AI-investigator.\n\nI\u2019ll demonstrate some of our early experiments with LLMs as OSINT operatives, covering deanonymization and profiling of individuals from public Web data. The OSINT capabilities of LLMs suggest that we need to fundamentally rethink the privacy and security risks stemming from large-scale processing of public data.',
        note: 'Remote talk',
    },
    { start: '9:40', end: '10:10', kind: 'talk', session: 'Invited talk', who: 'Helen Nissenbaum (Cornell Tech)' },
    { start: '10:10', end: '10:35', kind: 'break', session: 'Coffee break + posters' },
    {
        start: '10:35',
        end: '11:05',
        kind: 'talk',
        session: 'Invited talk',
        who: 'Ruoxi Jia (Virginia Tech)',
        talk: 'A North Star for a Human-Centered Data Economy',
        abstract: 'AI systems draw their capabilities from human knowledge, creativity, and effort, yet the people who generate training data often have little visibility into its use or participation in the value it creates. What should guide the design of a data economy that works for both AI developers and data contributors? In this talk, I argue that a sustainable AI economy requires infrastructure that makes human contributions discoverable, traceable, and meaningfully rewarded. Drawing on our analysis of 73 publicly disclosed data deals, I examine three structural obstacles: missing provenance, unequal bargaining power, and pricing that fails to reflect data\u2019s evolving, task-dependent value. I then introduce a framework for equitable data exchange and discuss recent work on two of its technical foundations: task\u2013data matching and data valuation. These advances offer building blocks for connecting useful data with downstream needs and informing how contributors are compensated.',
    },
    {
        start: '11:05',
        end: '11:35',
        kind: 'talk',
        session: 'Invited talk',
        who: 'Maarten Sap (Carnegie Mellon University)',
        talk: 'Social Intelligence in LLMs: Implications for AI Privacy and Safety',
        abstract: 'LLMs are increasingly deployed in settings where they must display social intelligence, yet it\u2019s unclear that they even have social intelligence, or that socially intelligent AI is safe for users. In this talk, I will discuss ongoing research related to how user-centric privacy and safety are affected by social intelligence in AI. I will first introduce Sotopia-ToM, a new multi-agent benchmark to measure how well LLM agents navigate information asymmetry, finding severe privacy violations in many LLMs. Then, I will turn to risks of hidden manipulation by LLMs, demonstrating that while LLMs can manipulate users and cause real belief shift, they struggle to detect such manipulation, posing significant risks. I\u2019ll conclude with some future directions towards more socially intelligent and safer LLMs.',
    },
    { start: '11:35', end: '12:05', kind: 'talk', session: 'Invited talk', who: 'Nina Taft (Google)' },
    { start: '12:05', end: '13:25', kind: 'break', session: 'Lunch' },
    { start: '13:25', end: '14:10', kind: 'panel', session: 'Panel discussion', who: 'Panelists: Helen Nissenbaum, Ruoxi Jia, Maarten Sap, Nina Taft; Moderator: Niloofar Mireshghallah' },
    { start: '14:10', end: '14:15', kind: 'break', session: 'Break' },
    { start: '14:15', end: '14:25', kind: 'spotlight', session: 'Spotlight talk', paper: 'PrivacySIM: Evaluating LLM Simulation of User Privacy Behavior', authors: 'James Flemings, Murali Annavaram' },
    { start: '14:25', end: '14:35', kind: 'spotlight', session: 'Spotlight talk', paper: 'Natively Unlearnable Large Language Models', authors: 'Gaurav Rohit Ghosal, Pratyush Maini, Aditi Raghunathan' },
    { start: '14:35', end: '14:45', kind: 'spotlight', session: 'Spotlight talk', paper: 'Your Agent, Their Asset: A Real-World Safety Analysis of OpenClaw', authors: 'Zijun Wang, Haoqin Tu, Letian Zhang, Hardy Chen, Juncheng Wu, Xiangyan Liu, Zhenlong Yuan, Tianyu Pang, Michael Qizhe Shieh, Fengze Liu, Zeyu Zheng, Huaxiu Yao, Yuyin Zhou, Cihang Xie' },
    { start: '14:45', end: '14:55', kind: 'spotlight', session: 'Spotlight talk', paper: "Risk vs. Reward: Supporting Practitioners' Understanding of LLM Privacy Risks", authors: 'Aseem Shrey, Weiqian Zhang, Ece Gumusel, Hana Habib' },
    { start: '14:55', end: '15:05', kind: 'spotlight', session: 'Spotlight talk', paper: 'Loose Lips: Understanding Privacy Leakage in Agentic Dialogue', authors: 'Soumya Sharma, Ayana Hussain, Héber Hwang Arcolezi, Ulrich Aïvodji, Spandana Gella, Adriana Romero-Soriano, Golnoosh Farnadi' },
    { start: '15:05', end: '15:15', kind: 'spotlight', session: 'Spotlight talk', paper: 'Act on Your Behalf, Beyond Your Authorization: Benchmarking LLM Agent Authorization Alignment', authors: 'Zhiping Zhang, Zihao Huang, Franklin Mingzhe Li, Tianshi Li' },
    { start: '15:15', end: '15:25', kind: 'spotlight', session: 'Spotlight talk', paper: 'Auditing Prompt Injection Defenses Before They Reach Users: What Strong Adversaries Reveal', authors: 'Xiaoxue Yang, Bozhidar Stevanoski, Matthieu Meeus, Yves-Alexandre de Montjoye' },
    { start: '15:25', end: '16:15', kind: 'break', session: 'Poster session + coffee' },
    { start: '16:15', end: '17:15', kind: 'misc', session: 'Unconference discussions' },
    { start: '17:15', end: '17:30', kind: 'misc', session: 'Closing remarks' },
];

---

<Layout title="Home">

    <section class="hero" aria-labelledby="hero-title" slot="hero">
        <div class="hero-motif" aria-hidden="true"></div>
        <div class="hero-content">
            <p class="hero-eyebrow">2nd Workshop · HAIPS@COLM 2026</p>
            <h1 id="hero-title" class="hero-title">Human-Centered Privacy and Security for <span class="hero-accent">Language Models</span></h1>
            <p class="hero-tagline">Studying, critiquing, and building privacy and security protections for language models used by real people.</p>
            <p class="hero-meta">
                <span>October 9, 2026</span>
                <span aria-hidden="true" class="hero-sep">·</span>
                <span>Hilton Union Square, Union Square 19&amp;20 (Fourth Floor), San Francisco</span>
                <span aria-hidden="true" class="hero-sep">·</span>
                <span>Co-located with <a href="https://colmweb.org/" target="_blank" rel="noopener noreferrer">COLM 2026</a></span>
            </p>
            <div class="hero-cta">
                <a href="https://openreview.net/group?id=colmweb.org/COLM/2026/Workshop/HAIPS" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Submit Paper</a>
                <a href="#cfp" class="btn btn-secondary">Call for Papers</a>
                <a href="#dates" class="btn btn-secondary">Key Dates</a>
            </div>
        </div>
    </section>

    <p>
        Language models are rapidly becoming embedded in the interaction fabric of our society &mdash; as assistants, tutors, collaborators, and autonomous agents across domains from healthcare to software engineering to creative work. Their versatility makes them uniquely powerful but also uniquely hard to secure: privacy and security risks arise not just from model internals but from the rich, open-ended ways people interact with and through these systems.
    </p>

    <blockquote class="pull-quote">
        Humans sit at the center of these challenges &mdash; as victims of privacy violations and manipulation, as intentional or unintentional facilitators of risk, and as bystanders whose data is swept up without consent.
    </blockquote>

    <p>
        HAIPS@COLM aims to bring a human-centered, interdisciplinary lens to LM privacy and security, building on the <a href="/haips2025">1st HAIPS Workshop</a> held at ACM CCS 2025. We aim to foster a two-way exchange between the COLM community and researchers in HCI, usable security, and policy &mdash; grounding human-centered approaches in what LMs actually do, and informing model design with how people actually experience them.
    </p>

    <section id="dates">
        <h2>Key Dates</h2>
        <ol class="dates-grid">
            <li class="date-card">
                <span class="date-label">Submission Deadline</span>
                <time class="date-value" datetime="2026-06-23">June 23, 2026</time>
            </li>
            <li class="date-card">
                <span class="date-label">Notification of Acceptance</span>
                <time class="date-value" datetime="2026-07-24">July 24, 2026</time>
            </li>
            <li class="date-card">
                <span class="date-label">Camera-Ready Deadline</span>
                <time class="date-value" datetime="2026-08-20">August 20, 2026</time>
            </li>
            <li class="date-card date-card-workshop">
                <span class="date-label">Workshop <span class="date-pill" aria-hidden="true">Event Day</span></span>
                <time class="date-value" datetime="2026-10-09">October 9, 2026</time>
            </li>
        </ol>
    </section>

    <section id="speakers">
        <h2>Invited Speakers</h2>
        <ul class="people-grid">
            {speakers.map(s => (
                <li class="person-card">
                    {s.profilePic ? (
                        <img src={s.profilePic} alt={`Profile photo of ${s.name}`} class="person-pic" />
                    ) : (
                        <div class="person-pic person-pic-placeholder"></div>
                    )}
                    <div class="person-name">
                        {s.website ? (
                            <a href={s.website} target="_blank" rel="noopener noreferrer">{s.name}</a>
                        ) : (
                            <span>{s.name}</span>
                        )}
                    </div>
                    <div class="person-affil">{s.affiliation}</div>
                </li>
            ))}
        </ul>
    </section>

    <section id="schedule">
        <h2>Schedule</h2>
        <p class="schedule-meta">Friday, October 9, 2026 &middot; Hilton Union Square, Union Square 19&amp;20 (Fourth Floor), San Francisco &middot; All times are Pacific Daylight Time (PDT). Each spotlight is an 8-minute talk followed by 2 minutes of Q&amp;A.</p>
        <table class="schedule-table">
            <thead>
                <tr>
                    <th scope="col">Time</th>
                    <th scope="col">Session</th>
                    <th scope="col">Details</th>
                </tr>
            </thead>
            <tbody>
                {schedule.map(item => (
                    <tr class={`row-${item.kind}`}>
                        <td class="schedule-time">{item.start}&ndash;{item.end}</td>
                        <td class="schedule-session">{item.session}</td>
                        <td class={`schedule-details${item.who || item.talk || item.paper || item.authors || item.note ? '' : ' schedule-details-empty'}`}>
                            {item.who && <span class="schedule-who">{item.who}</span>}
                            {item.talk && <span class="schedule-paper">{item.talk}</span>}
                            {item.abstract && (
                                <details class="schedule-abstract">
                                    <summary>Abstract</summary>
                                    {item.abstract.split('\n\n').map(para => <p>{para}</p>)}
                                </details>
                            )}
                            {item.paper && <span class="schedule-paper">{item.paper}</span>}
                            {item.authors && <span class="schedule-authors">{item.authors}</span>}
                            {item.note && <span class="schedule-note">{item.note}</span>}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </section>

    <section id="cfp">
        <h2>Call for Papers</h2>
        <p>
            HAIPS@COLM invites work that studies, critiques, and builds privacy, security, and safety protections for language models and agentic AI systems as technologies used by real people. We welcome submissions from both the core language-modeling community and the HCI, usable security, privacy, and policy communities.
        </p>
        <p>
            We especially encourage work that connects technical mechanisms with human needs, including systems, tools, infrastructure, empirical studies, benchmarks, design work, policy analysis, audits, and position papers. Human-centered work need not always include a user study; technical papers are welcome when they clearly articulate the people, workflows, communities, or deployment contexts their work is intended to benefit.
        </p>

        <h3>Topics of Interest</h3>
        <p>Topics of interest include, but are not limited to:</p>
        <ul>
            <li>Human expectations, consent, and control over data used in LM systems</li>
            <li>Privacy- and security-preserving LM infrastructure for protecting people and institutions in real-world deployment contexts</li>
            <li>User-facing protections that help people understand and prevent LM privacy and security risks</li>
            <li>Human oversight, delegation, and accountability in agentic, personalized, and tool-using LM systems</li>
            <li>Evaluation and benchmarking of LM and LM-system privacy, security, and safety through a human lens</li>
            <li>Human impacts of adversarial LM-enabled privacy and security threats</li>
            <li>User vulnerability, manipulation, deception, and dark patterns involving language models</li>
            <li>Effects of language models used as simulated users, evaluators, auditors, or research participants</li>
            <li>LM-powered tools that support privacy, security, safety, and human agency</li>
            <li>Developer and organizational practices, risks, and responsibilities in LM design and deployment</li>
            <li>Human-centered policy and governance for LM privacy, security, and safety</li>
        </ul>

        <p>
            Our goal is to bring together researchers who identify emerging risks, understand their human and societal implications, and build practical protections that make language-model systems safer, more private, more secure, and more accountable in real-world use.
        </p>

        <h3>Submission Format</h3>
        <ul>
            <li><strong>Long papers:</strong> up to 9 pages, excluding references and appendices.</li>
            <li><strong>Short papers:</strong> up to 4 pages, excluding references and appendices.</li>
            <li>Submissions may use the <a href="https://colmweb.org/cfp.html" target="_blank" rel="noopener noreferrer">COLM</a>, <a href="https://www.overleaf.com/latex/templates/formatting-instructions-for-neurips-2026/bjdwqfdkyftc" target="_blank" rel="noopener noreferrer">NeurIPS</a>, or <a href="https://github.com/acl-org/acl-style-files" target="_blank" rel="noopener noreferrer">EMNLP</a> format.</li>
            <li>Accepted papers are <strong>non-archival</strong>, leaving authors free to submit revised versions to other venues.</li>
        </ul>

        <h3>Review Process</h3>
        <p>
            Review will be <strong>double-blind on OpenReview</strong>, with at least two reviewers per paper. Conflicts of interest will be managed through OpenReview&rsquo;s COI detection and self-declared conflicts.
        </p>

        <h3>Awards</h3>
        <p>
            We aim to establish <strong>Best Paper</strong> and <strong>Best Student Paper</strong> awards to highlight outstanding work, with particular attention to early-career researchers.
        </p>

        <p>Submit your paper via OpenReview: <a href="https://openreview.net/group?id=colmweb.org/COLM/2026/Workshop/HAIPS" target="_blank" rel="noopener noreferrer">https://openreview.net/group?id=colmweb.org/COLM/2026/Workshop/HAIPS</a></p>
    </section>

    <section id="organization">
        <h2>Organizers</h2>
        <ul class="people-grid">
            {organizers.chairs.map(chair => (
                <li class="person-card">
                    {chair.profilePic ? (
                        <img src={chair.profilePic} alt={`Profile photo of ${chair.name}`} class="person-pic" />
                    ) : (
                        <div class="person-pic person-pic-placeholder"></div>
                    )}
                    <div class="person-name">
                        {chair.website && chair.website !== '#' ? (
                            <a href={chair.website} target="_blank" rel="noopener noreferrer">{chair.name}</a>
                        ) : (
                            <span>{chair.name}</span>
                        )}
                    </div>
                    <div class="person-affil">{chair.affiliation}</div>
                </li>
            ))}
        </ul>
    </section>

</Layout>

<style>
    /* ───── Hero ─────────────────────────────────────────────── */
    .hero {
        position: relative;
        overflow: hidden;
        background-color: var(--bg-secondary);
        background-image:
            radial-gradient(circle at 12% 15%, rgba(52, 152, 219, 0.10), transparent 45%),
            radial-gradient(circle at 88% 85%, rgba(217, 119, 6, 0.07), transparent 50%);
        border: none;
        padding: 3.25rem 1.5rem 2.75rem;
        text-align: center;
        /* Rendered as a direct child of <body> via Layout's `hero` slot, so
           it spans the body width naturally — no 100vw breakout needed.
           Top margin clears the fixed header. */
        margin-top: calc(var(--header-height, 130px));
        margin-bottom: 2.5rem;
    }
    /* Faint dot grid suggests data nodes / participants in a network. */
    .hero-motif {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(44, 62, 80, 0.07) 1px, transparent 1.4px);
        background-size: 26px 26px;
        mask-image: radial-gradient(ellipse at center, black 35%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 80%);
        pointer-events: none;
    }
    .hero-content {
        position: relative; /* sit above motif */
        max-width: 720px;
        margin: 0 auto;
    }
    .hero-eyebrow {
        margin: 0 0 0.9rem;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent-dark);
    }
    .hero-title {
        margin: 0 0 0.85rem;
        font-size: clamp(2.1rem, 6vw, 3.1rem);
        line-height: 1.1;
        color: var(--text-primary);
        border-bottom: none;
        padding-bottom: 0;
        letter-spacing: -0.015em;
    }
    .hero-accent {
        color: var(--accent-dark);
    }
    .hero-tagline {
        margin: 0 auto 1.25rem;
        max-width: 600px;
        font-size: clamp(1.02rem, 2.2vw, 1.18rem);
        color: var(--text-primary);
        line-height: 1.5;
    }
    .hero-meta {
        margin: 0 0 1.5rem;
        font-size: 0.97rem;
        color: var(--text-primary);
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem 0.7rem;
    }
    .hero-meta a {
        color: var(--accent-dark);
        text-decoration: underline;
        text-decoration-color: rgba(41, 128, 185, 0.35);
        text-underline-offset: 3px;
    }
    .hero-sep {
        color: var(--text-secondary);
    }
    .hero-cta {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 0.25rem;
    }

    /* ───── Buttons ──────────────────────────────────────────── */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1.4rem;
        font-size: 0.97rem;
        font-weight: 600;
        line-height: 1;
        border-radius: var(--radius-sm);
        border: 1.5px solid transparent;
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease,
                    border-color 0.15s ease, transform 0.1s ease,
                    box-shadow 0.15s ease;
    }
    .btn:hover {
        text-decoration: none;
        transform: translateY(-1px);
    }
    .btn:active {
        transform: translateY(0);
    }
    .btn-primary {
        background: var(--accent-dark);
        color: #fff;
        border-color: var(--accent-dark);
        box-shadow: 0 1px 2px rgba(41, 128, 185, 0.25);
    }
    .btn-primary:hover {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
        box-shadow: 0 3px 8px rgba(52, 152, 219, 0.3);
    }
    .btn-secondary {
        background: transparent;
        color: var(--accent-dark);
        border-color: var(--accent-dark);
    }
    .btn-secondary:hover {
        background: var(--accent-tint);
        color: var(--accent-dark);
    }

    /* ───── Pull-quote ───────────────────────────────────────── */
    .pull-quote {
        margin: 2.25rem 0;
        padding: 0.4rem 0 0.4rem 1.25rem;
        border-left: 4px solid var(--accent-warm);
        font-size: clamp(1.1rem, 2.4vw, 1.3rem);
        font-style: normal;
        font-weight: 500;
        line-height: 1.45;
        color: var(--text-primary);
        background: transparent;
    }

    /* ───── Key Dates ────────────────────────────────────────── */
    .dates-grid {
        list-style: none;
        padding-left: 0;
        margin: 1.5rem 0 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
    }
    .date-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-top: 3px solid var(--accent);
        border-radius: var(--radius-sm);
        padding: 1rem 1.1rem 1.1rem;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .date-card-workshop {
        border-top-color: var(--accent-warm);
        background: linear-gradient(180deg, var(--accent-warm-soft) 0%, var(--bg-card) 60%);
    }
    .date-label {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .date-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-primary);
        font-variant-numeric: tabular-nums;
    }
    .date-pill {
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        background: var(--accent-warm);
        color: #fff;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        text-transform: uppercase;
    }
    section {
        margin-bottom: 3rem;
        padding-top: 1rem;
    }
    section h2 {
        margin-top: 0;
        margin-bottom: 1.1rem;
        padding-bottom: 0.45rem;
        display: inline-block;
        border-bottom: 3px solid transparent;
        border-image: linear-gradient(to right, var(--accent) 0%, var(--accent) 65%, var(--accent-warm) 100%) 1;
        color: var(--text-primary);
    }
    section h3 {
        margin-top: 2.25rem;
        margin-bottom: 0.7rem;
        color: var(--text-primary);
    }
    /* Shared people grid (speakers + organizers) */
    .people-grid {
        list-style: none;
        padding-left: 0;
        margin-top: 1.5rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.5rem;
    }
    .person-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0.25rem;
    }
    .person-pic,
    .person-pic-placeholder {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        object-fit: cover;
        background-color: var(--accent-light);
        margin-bottom: 0.85rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
    .person-name {
        font-size: 1.02rem;
        font-weight: 600;
        line-height: 1.3;
        color: var(--text-primary);
    }
    .person-name a {
        color: var(--text-primary);
    }
    .person-name a:hover {
        color: var(--accent);
        text-decoration: none;
    }
    .person-affil {
